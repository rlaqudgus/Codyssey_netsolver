# Copy to .env (cp .env.example .env) and fill in. .env is git-ignored.
# On EC2: chmod 600 .env and make it owned by the service user.

# Which AI reads the photo: claude | gemini
# (unset = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set)
# AI_PROVIDER=gemini

# Claude (paid, prepaid credits at platform.claude.com)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# Gemini (free tier at aistudio.google.com; free-tier data may be used by Google to improve its products)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash   (gemini-3.8-flash hung with no response on 2026-11-02, see docs/troubleshooting.md case 4)
# GEMINI_THINKING=low   (minimal|low|medium|high; high used up the output budget -> MAX_TOKENS, see case 5)

# ACCESS_CODE=
# RATE_PER_10MIN=10
# HOST=127.0.0.1
# PORT=3000
