# net-solver API as a systemd service (runs server/server.js on 127.0.0.1:3000).
# Install:  sudo cp deploy/net-solver.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now net-solver
# Logs:     journalctl -u net-solver -f
# Use either this service OR the Docker container (deploy/Dockerfile), not both: both want port 3000.

[Unit]
Description=net-solver API (Node, behind Nginx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netsolver
Group=netsolver
WorkingDirectory=/opt/net-solver
# server.js reads /opt/net-solver/.env itself (owner netsolver, chmod 600).
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=3

# Hardening: the app only reads its own files and talks to the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
